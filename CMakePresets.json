{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Unix Makefiles",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_C_STANDARD": "11",
                "CMAKE_CXX_STANDARD": "20",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "LOGGER_TYPE": "hydrolib"
            }
        },
        {
            "name": "F4",
            "inherits": "default",
            "hidden": true,
            "toolchainFile": "${sourceDir}/resources/gcc-arm-none-eabi-f4.cmake",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-DSTM32F407xx",
                "CMAKE_CXX_FLAGS": "-DSTM32F407xx",
                "HYDRV_MCU_FAMILY": "F4"
            }
        },
        {
            "name": "F1",
            "inherits": "default",
            "hidden": true,
            "toolchainFile": "${sourceDir}/resources/gcc-arm-none-eabi-f1.cmake",
            "cacheVariables": {
                "CMAKE_C_FLAGS": "-DSTM32F103xB",
                "CMAKE_CXX_FLAGS": "-DSTM32F103xB",
                "HYDRV_MCU_FAMILY": "F1"
            }
        },
        {
            "name": "debug",
            "inherits": "default",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "HYDRV_BUILD_EXAMPLES": "ON"
            }
        },
        {
            "name": "debug_with_tests",
            "inherits": "debug",
            "hidden": true,
            "cacheVariables": {
                "HYDRV_RUN_TESTS": "ON"
            }
        },
        {
            "name": "DebugF4",
            "inherits": [
                "F4",
                "debug"
            ]
        },
        {
            "name": "DebugF1",
            "inherits": [
                "F1",
                "debug"
            ]
        },
        {
            "name": "DebugWithTestsF4",
            "inherits": [
                "F4",
                "debug_with_tests"
            ]
        },
        {
            "name": "DebugWithTestsF1",
            "inherits": [
                "F1",
                "debug_with_tests"
            ]
        }
    ]
}